// pipelines_templates/CI_CD_Project/app_deployment/Jenkinsfile
// Branch-aware CI/CD pipeline for GitOps-style deployments using Docker Agent
//
// Workflows:
//   PR to dev       → Validate, Read Version, Version Gate, Install Dependencies, Build & Test, Docker Build, Container Validate, Register (PR_VALIDATED)
//   Merge to dev    → Validate, Read Version, Version Gate, Install Dependencies, Build & Test, Docker Build, Container Validate, Push, Cleanup, Register (DEV), Update & Push Manifests
//   Merge to main   → Read Version, Promote (PRODUCTION), Update & Push PROD Manifests

pipeline {
    agent {
        docker {
            image 'node:18-alpine'
            args '-u root:root -v /var/run/docker.sock:/var/run/docker.sock --entrypoint='
        }
    }

    environment {
        APP_VERSION    = ''
        PIPELINE_IMAGE = ''
    }

    stages {

        // ───────────────────────────────────────────
        // STAGE 1: Checkout Source Code
        // ───────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ───────────────────────────────────────────
        // STAGE 2: Install Agent Dependencies
        //   Installs AWS CLI, kubectl, Docker CLI, Git if install_tools is enabled
        // ───────────────────────────────────────────
        stage('Install Agent Dependencies') {
            when {
                expression {
                    return (pipelineConfig.libraries?.npm?.install_tools == true ||
                            pipelineConfig.libraries?.docker?.install_tools == true)
                }
            }
            steps {
                installTools()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 3: Read Version
        // ───────────────────────────────────────────
        stage('Read Version') {
            steps {
                script {
                    env.APP_VERSION = readVersion()
                }
            }
        }

        // ───────────────────────────────────────────
        // STAGE 4: Version Gate (PR + DEV only)
        //   Blocks if version already exists
        // ───────────────────────────────────────────
        stage('Version Gate') {
            when {
                not { branch 'main' }
            }
            steps {
                versionGate(environment: 'DEV')
            }
        }

        // ───────────────────────────────────────────
        // STAGE 5: Build & Test Application (PR + DEV only)
        // ───────────────────────────────────────────
        stage('Build & Test') {
            when {
                not { branch 'main' }
            }
            steps {
                installDeps()
                lint()
                testApp()
                buildApp()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 6: Docker Build (PR + DEV only)
        // ───────────────────────────────────────────
        stage('Docker Build') {
            when {
                not { branch 'main' }
            }
            steps {
                script {
                    env.PIPELINE_IMAGE = buildImage()
                }
            }
        }

        // ───────────────────────────────────────────
        // STAGE 7: Container Validation (PR + DEV only)
        //   Run the image to verify it doesn't crash
        // ───────────────────────────────────────────
        stage('Container Validation') {
            when {
                not { branch 'main' }
            }
            steps {
                containerValidate()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 8: Docker Push (DEV merge only)
        //   Login, tag, and push the immutable artifact
        // ───────────────────────────────────────────
        stage('Docker Push') {
            when {
                branch 'dev'
                not { changeRequest() }
            }
            steps {
                script {
                    login()
                    def tags = tag()
                    push(tags)
                }
            }
        }

        // ───────────────────────────────────────────
        // STAGE 9: Cleanup Docker (DEV merge only)
        // ───────────────────────────────────────────
        stage('Docker Cleanup') {
            when {
                branch 'dev'
                not { changeRequest() }
            }
            steps {
                cleanup()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 10A: Register Version — PR_VALIDATED
        //   Only on Pull Requests
        // ───────────────────────────────────────────
        stage('Register Version (PR)') {
            when {
                changeRequest()
            }
            steps {
                registerVersion(environment: 'PR_VALIDATED')
            }
        }

        // ───────────────────────────────────────────
        // STAGE 10B: Register Version — DEV
        //   Only on merge to dev (not PRs)
        // ───────────────────────────────────────────
        stage('Register Version (DEV)') {
            when {
                branch 'dev'
                not { changeRequest() }
            }
            steps {
                registerVersion(environment: 'DEV')
            }
        }

        // ───────────────────────────────────────────
        // STAGE 11: Promote to PRODUCTION (main only)
        //   No rebuild, no retest, no re-push
        //   Reuses the immutable artifact from DEV
        // ───────────────────────────────────────────
        stage('Promote to Production') {
            when {
                branch 'main'
            }
            steps {
                promoteVersion(target_environment: 'PRODUCTION')
            }
        }

        // ───────────────────────────────────────────
        // STAGE 12: Update Manifests (DEV merge + main)
        //   Checkout single main branch, update tag, create feature branch & open PR
        // ───────────────────────────────────────────
        stage('Update Manifests') {
            when {
                anyOf {
                    allOf { branch 'dev';  not { changeRequest() } }
                    branch 'main'
                }
            }
            steps {
                script {
                    String targetEnv = (env.BRANCH_NAME == 'main') ? 'PRODUCTION' : 'DEV'
                    String featureBranch = "deploy/${env.APP_VERSION}-${targetEnv.toLowerCase()}-${env.BUILD_NUMBER}"

                    checkOutRemoteSCM(branch: 'main')

                    updateManifest(
                        new_tag: env.APP_VERSION
                    )

                    gitPush(
                        target_branch: 'main',
                        new_branch: featureBranch,
                        commit_message: "ci: deploy ${env.APP_VERSION} to ${targetEnv} [skip ci]",
                        create_pr: true
                    )
                }
            }
        }
        
    }
        

    post {
        always {
            script {
                try { logout() } catch (e) { echo "Logout skipped: ${e.message}" }
            }
            cleanWs()
        }
        failure {
            echo "Pipeline FAILED for version: ${env.APP_VERSION ?: 'unknown'}"
        }
        success {
            echo "Pipeline SUCCEEDED for version: ${env.APP_VERSION ?: 'unknown'}"
        }
    }
}
