// pipelines_templates/CI_CD_Project/terraform_infra/Jenkinsfile
// Single-branch (main) Terraform Infrastructure Pipeline

pipeline {
    agent {
        docker {
            image "hashicorp/terraform:latest"
            args '-u root:root --entrypoint='
        }
    }

    parameters {
        choice(
            name: 'TARGET_ENVIRONMENT',
            choices: ['dev', 'prod'],
            description: 'Select target environment for Terraform plan/apply'
        )
        choice(
            name: 'ACTION',
            choices: ['apply', 'destroy'],
            description: 'Action to perform on infrastructure'
        )
    }

    environment {
        TARGET_ENV = "${params.TARGET_ENVIRONMENT ?: 'dev'}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                script {
                    terraform.checkoutCode()
                }
            }
        }

        stage('Install Dependencies') {
            when {
                expression { return pipelineConfig.libraries?.terraform?.install_tools == true }
            }
            steps {
                echo "Installing Checkov inside container..."
                sh 'apk update && apk add --no-cache python3 py3-pip git && pip3 install checkov --break-system-packages'
            }
        }

        stage('Initialize & Validate') {
            steps {
                script {
                    terraform.init()
                    terraform.validate()
                }
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    terraform.checkov()
                }
            }
        }

        stage('Plan Infrastructure') {
            steps {
                script {
                    terraform.plan()
                }
            }
        }

        stage('Approval Guardrail') {
            when {
                branch 'main'
                not { changeRequest() }
            }
            steps {
                script {
                    terraform.approval(is_destroy: params.ACTION == 'destroy')
                }
            }
        }

        stage('Execute Deploy / Destroy') {
            when {
                branch 'main'
                not { changeRequest() }
            }
            steps {
                script {
                    if (params.ACTION == 'destroy') {
                        terraform.destroy()
                    } else {
                        terraform.deploy()
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
