// pipelines_templates/CI_CD_Project/terraform_infra/Jenkinsfile
// Single-branch (main) Terraform Infrastructure Pipeline

pipeline {
    agent {
        docker {
            image "hashicorp/terraform:latest"
            args '-u root:root --entrypoint='
        }
    }

    parameters {
        choice(
            name: 'ACTION',
            choices: ['apply', 'destroy'],
            description: 'Action to perform on infrastructure'
        )
    }

    stages {
        stage('Checkout Code') {
            steps {
                tfCheckoutCode()
            }
        }

        stage('Install Dependencies') {
            when {
                expression { return pipelineConfig.libraries?.terraform?.install_tools == true }
            }
            steps {
                tfInstallTools()
            }
        }

        stage('Initialize & Validate') {
            steps {
                init()
                validate()
            }
        }

        stage('Security Scan') {
            steps {
                checkov()
            }
        }

        stage('Plan Infrastructure') {
            steps {
                plan()
            }
        }

        stage('Approval Guardrail') {
            when {
                branch 'main'
                not { changeRequest() }
            }
            steps {
                approval(is_destroy: params.ACTION == 'destroy')
            }
        }

        stage('Execute Deploy / Destroy') {
            when {
                branch 'main'
                not { changeRequest() }
            }
            steps {
                script {
                    if (params.ACTION == 'destroy') {
                        destroy()
                    } else {
                        tfDeploy()
                    }
                }
            }
        }
        
        stage('Archive Ansible Inventory') {
            when {
                branch 'main'
                not { changeRequest() }
                expression { return params.ACTION != 'destroy' }
            }
            steps {
                archiveInventory()
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
