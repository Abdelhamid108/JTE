// pipelines_templates/CI_CD_Project/app_CD/Jenkinsfile
// GitOps CD pipeline for continuous deployment of Kubernetes manifests

pipeline {
    agent {
        docker {
            image "python:3.12-alpine"
            args '-u root:root --entrypoint='
        }
    }

    parameters {
        choice(
            name: 'TARGET_ENVIRONMENT',
            choices: ['auto', 'dev', 'prod', 'all'],
            description: 'Target environment to deploy. "auto" uses git changeset triggers.'
        )
    }

    stages {
        stage('Checkout Manifests') {
            steps {
                checkout scm
            }
        }

        stage('Install Agent Dependencies') {
            when {
                expression { return (pipelineConfig.libraries?.kubernetes?.install_tools == true || pipelineConfig.libraries?.ansible?.install_tools == true) }
            }
            steps {
                k8sInstallTools()
            }
        }

        stage('Fetch Terraform Inventory') {
            steps {
                fetchInventory()
            }
        }

        stage('Deploy to DEV') {
            when {
                anyOf {
                    changeset "dev/**"
                    expression { return params.TARGET_ENVIRONMENT == 'dev' || params.TARGET_ENVIRONMENT == 'all' }
                }
            }
            steps {
                echo "Syncing DEV CLUSTER..."
                input message: "Approve Deploying to DEV CLUSTER?", ok: "proceed"
                k8sDeploy(
                    namespace: 'weather-app',
                    target_folder: 'dev'
                )
            }
        }

        stage('Deploy to PROD') {
            when {
                anyOf {
                    changeset "prod/**"
                    expression { return params.TARGET_ENVIRONMENT == 'prod' || params.TARGET_ENVIRONMENT == 'all' }
                }
            }
            steps {
                echo "Syncing PROD CLUSTER..."
                input message: "Approve Deploying to PROD CLUSTER?", ok: "proceed"
                k8sDeploy(
                    namespace: 'weather-app',
                    target_folder: 'prod'
                )
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "CD Pipeline completed successfully. Clusters are synced with Git!"
        }
        failure {
            echo "CD Pipeline failed. Check the logs to see why kubectl rejected the YAML."
        }
    }
}