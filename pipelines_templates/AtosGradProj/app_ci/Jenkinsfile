// pipelines_templates/AtosGradProj/app_ci/Jenkinsfile
//
// Declarative CI/CD Pipeline — Atos Graduation Project
// Flow: Feature PR -> Dev Merge -> Test Promotion -> Prod Release
// Deploys via Argo CD Image Updater (immutable tags: dev-*, test-*, prod-*)

pipeline {
    agent none

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    stages {

        // ── ALL BRANCHES & PRs ──────────────────────────────────
        stage('Checkout & Read Version') {
            agent { label 'master' }
            steps {
                checkout scm
                readVersion()
            }
        }

        // ── DEV / PR→dev: Source Quality Gates ─────────────────
        stage('Build & Test') {
            agent { label 'master' }
            when { anyOf { branch 'dev'; changeRequest(target: 'dev') } }
            steps { verify() }
        }

        stage('Trivy Dependency Scan') {
            agent { label 'master' }
            when { anyOf { branch 'dev'; changeRequest(target: 'dev') } }
            steps { scanFilesystem() }
        }

        stage('SonarQube Analysis') {
            agent { label 'master' }
            when { anyOf { branch 'dev'; changeRequest(target: 'dev') } }
            steps { scan() }
        }

        // ── DEV / PR→dev: Container Quality Gates ──────────────
        stage('Docker Build') {
            agent { label 'master' }
            when { anyOf { branch 'dev'; changeRequest(target: 'dev') } }
            steps {
                buildImage()
            }
        }

        stage('Container Smoke Validation') {
            agent { label 'master' }
            when { anyOf { branch 'dev'; changeRequest(target: 'dev') } }
            steps { containerValidate() }
        }

        stage('Trivy Image Scan') {
            agent { label 'master' }
            when { anyOf { branch 'dev'; changeRequest(target: 'dev') } }
            steps { scanImage() }
        }

        // ── DEV MERGE: Publish ──────────────────────────────────
        stage('Version Gate (DEV)') {
            agent { label 'master' }
            when { branch 'dev'; not { changeRequest() } }
            steps { versionGate(environment: 'dev') }
        }

        stage('Push Image (DEV)') {
            agent { label 'master' }
            when { branch 'dev'; not { changeRequest() } }
            steps {
                login()
                pushImage(environment: 'dev')
            }
        }

        // ── TEST BRANCH: Promote ────────────────────────────────
        stage('Version Gate (TEST)') {
            agent { label 'master' }
            when { branch 'test'; not { changeRequest() } }
            steps {
                login()
                versionGate(environment: 'test')
            }
        }

        stage('Promote Image (TEST)') {
            agent { label 'master' }
            when { branch 'test'; not { changeRequest() } }
            steps { promoteImage(environment: 'test') }
        }

        // ── MAIN BRANCH: Production Release ────────────────────
        stage('Version Gate (PROD)') {
            agent { label 'master' }
            when { branch 'main'; not { changeRequest() } }
            steps {
                login()
                versionGate(environment: 'prod')
            }
        }

        stage('Production Approval Guardrail') {
            when { branch 'main'; not { changeRequest() } }
            options { timeout(time: 24, unit: 'HOURS') }
            steps {
                input message: "Approve deployment to PRODUCTION?", ok: "Release to Prod"
            }
        }

        stage('Production Fresh CVE Scan') {
            agent { label 'master' }
            when { branch 'main'; not { changeRequest() } }
            steps { scanImage(fresh_pull: true) }
        }

        stage('Release to PROD') {
            agent { label 'master' }
            when { branch 'main'; not { changeRequest() } }
            steps {
                promoteImage(environment: 'prod')
                createTag()
            }
        }
    }

    post {
        always  { node('master') { cleanWs() } }
        success { echo "app_ci: SUCCEEDED — branch '${env.BRANCH_NAME}' (${env.APP_VERSION ?: 'N/A'})" }
        failure { echo "app_ci: FAILED    — branch '${env.BRANCH_NAME}' (${env.APP_VERSION ?: 'N/A'})" }
    }
}