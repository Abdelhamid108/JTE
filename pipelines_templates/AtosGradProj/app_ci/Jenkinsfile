// pipelines_templates/AtosGradProj/app_ci/Jenkinsfile
//
// Application CI Pipeline (Declarative Syntax)
// Flow:
//   Checkout -> Change Detection -> Read Version -> Maven Verify & Test
//   -> SonarQube -> Package -> ECR Login -> Docker Build -> Trivy Scan
//   -> ECR Push -> GitOps Dev Update

pipeline {
    agent {
        label 'master'
    }

    stages {

        // ───────────────────────────────────────────
        // STAGE 1: Checkout Source Code
        // ───────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ───────────────────────────────────────────
        // STAGE 2: Change Detection
        // ───────────────────────────────────────────
        stage('Change Detection') {
            steps {
                script {
                    if (!applicationChanged()) {
                        echo "app_ci: no changes under application/** or JTE/** — skipping the rest of the application pipeline."
                        currentBuild.result = 'SUCCESS'
                    }
                }
            }
        }

        // ───────────────────────────────────────────
        // STAGE 3: Read Application Version
        // ───────────────────────────────────────────
        stage('Read Version') {
            when {
                expression { return currentBuild.result != 'SUCCESS' }
            }
            steps {
                readVersion()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 4: Maven Test & Verify (Unit + Integration Tests)
        // ───────────────────────────────────────────
        stage('Maven Test & Verify') {
            when {
                expression { return currentBuild.result != 'SUCCESS' }
            }
            steps {
                verify()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 5: SonarQube Code Quality Scan
        // ───────────────────────────────────────────
        stage('SonarQube Scan') {
            when {
                expression { return currentBuild.result != 'SUCCESS' }
            }
            steps {
                scan()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 6: Package Application JAR
        // ───────────────────────────────────────────
        stage('Package Application') {
            when {
                expression { return currentBuild.result != 'SUCCESS' }
            }
            steps {
                packageApp()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 7: ECR Login
        // ───────────────────────────────────────────
        stage('ECR Login') {
            when {
                expression { return currentBuild.result != 'SUCCESS' }
            }
            steps {
                login()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 8: Docker Image Build
        // ───────────────────────────────────────────
        stage('Docker Build') {
            when {
                expression { return currentBuild.result != 'SUCCESS' }
            }
            steps {
                buildImage()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 9: Trivy Vulnerability Scan
        // ───────────────────────────────────────────
        stage('Trivy Image Scan') {
            when {
                expression { return currentBuild.result != 'SUCCESS' }
            }
            steps {
                scanImage()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 10: Push Image to AWS ECR
        // ───────────────────────────────────────────
        stage('Push to ECR') {
            when {
                expression { return currentBuild.result != 'SUCCESS' }
            }
            steps {
                pushImage()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 11: GitOps Dev Environment Update
        // ───────────────────────────────────────────
        stage('GitOps: Update dev') {
            when {
                expression { return currentBuild.result != 'SUCCESS' }
            }
            steps {
                script {
                    updateValues(environment: 'dev')
                    commitChanges(environment: 'dev')
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "app_ci: Completed successfully for version ${env.APP_VERSION ?: 'N/A'}. Argo CD will reconcile 'dev'."
        }
        failure {
            echo "app_ci: FAILED for version ${env.APP_VERSION ?: 'N/A'}."
        }
    }
}