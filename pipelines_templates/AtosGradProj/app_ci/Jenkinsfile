// pipelines_templates/AtosGradProj/app_ci/Jenkinsfile
//
// Declarative CI/CD Pipeline — Atos Graduation Project
// Flow: Feature PR -> Dev Merge -> Test Promotion -> Prod Release
// Deploys via Argo CD Image Updater (immutable tags: dev-*, test-*, prod-*)

pipeline {
    agent none

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    stages {

        stage('Checkout & Version Check') {
            agent { label 'master' }
            steps {
                checkout scm
                getGitVersion()
                imageExists(tag: "dev-${env.GIT_TAG}")
            }
        }

        stage('Trivy FS Scan') {
            agent { label 'master' }
            when { anyOf { branch 'main', changeRequest target: 'main', branch: 'feature/*', comparator: 'GLOB' }}
            steps { scanFilesystem() }
        }

        stage('Compile') {
            agent { label 'master' }
            when { anyOf { branch 'main', changeRequest target: 'main', branch: 'feature/*', comparator: 'GLOB' } }
            steps { compileApp() }
        }

        stage('Unit Test'){
            agent { label 'master'}
            when { anyOf { 
                branch 'main'
                changeRequest target: 'main', branch: 'feature/*', comparator: 'GLOB' } }
            steps { test() }
        }

        stage('SonarQube Analysis') {
            agent { label 'master' }
            when { anyOf {
                branch 'main' 
                changeRequest target: 'main', branch: 'feature/*', comparator: 'GLOB'
            } }
            steps { scan() }
        }

        stage ('Maven Package'){
            agent { label 'master' }
            when { anyOf
                {
                    branch 'main'
                    changeRequest target: 'main', branch: 'feature/*', comparator: 'GLOB'
                }
            }
            steps { packageApp() }
        }

        stage('Docker Build') {
            agent { label 'master' }
            when { anyOf 
                {
                    branch 'main'  
                    changeRequest target: 'main', branch: 'feature/*', comparator: 'GLOB'
                 } 
            }
            steps {
                buildImage()
            }
        }

        stage('Push Image (DEV)') {
            agent { label 'master' }
            when { branch 'main'; not { changeRequest() } }
            steps {
                push("dev-${env.GIT_TAG}")
            }
        }

        stage("Testing Dev") {
            agent { label 'master' }
            when { branch 'main'; not { changeRequest() } }
            steps {
                sh "echo 'Testing DEV environment.....'"
            }
        }

        stage('Testing Environment Approval Guardrail') {
            when { branch 'main'; not { changeRequest() } }
            steps {
                script {
                    env.PROCEED_TEST = approvalGuardrail(
                        environment: 'TEST',
                        timeout_hours: 24,
                        message: "Approve deployment to Testing Environment?"
                    )
                }
            }
        }

        stage('Push Image (TEST)') {
            agent { label 'master' }
            when {
                branch 'main'
                not { changeRequest() }
                expression { env.PROCEED_TEST == 'true' }
            }
            steps {
                retagImage(
                    source_tag: "dev-${env.GIT_TAG}",
                    target_tag: "test-${env.GIT_TAG}"
                )
            }
        }

        stage("Testing on Test") {
            agent { label 'master' }
            when {
                branch 'main'
                not { changeRequest() }
                expression { env.PROCEED_TEST == 'true' }
            }
            steps {
                sh "echo 'Testing TEST environment.....'"
            }
        }

        // ── MAIN BRANCH: Production Release ────────────────────
        stage('Production Approval Guardrail') {
            when {
                branch 'main'
                not { changeRequest() }
                expression { env.PROCEED_TEST == 'true' }
            }
            steps {
                script {
                    env.PROCEED_PROD = approvalGuardrail(
                        environment: 'PRODUCTION',
                        timeout_hours: 24,
                        message: "Approve deployment to PRODUCTION?"
                    )
                }
            }
        }

        stage('Release to PROD') {
            agent { label 'master' }
            when {
                branch 'main'
                not { changeRequest() }
                expression { env.PROCEED_PROD == 'true' }
            }
            steps {
                retagImage(
                    source_tag: "test-${env.GIT_TAG}",
                    target_tag: "prod-${env.GIT_TAG}"
                )
            }
        }
    }

    post {
        success { echo "app_ci: SUCCEEDED — branch '${env.BRANCH_NAME}' (Tag: ${env.GIT_TAG ?: 'N/A'})" }
        failure { echo "app_ci: FAILED    — branch '${env.BRANCH_NAME}' (Tag: ${env.GIT_TAG ?: 'N/A'})" }
    }
}