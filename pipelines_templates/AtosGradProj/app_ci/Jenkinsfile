// pipelines_templates/AtosGradProj/app_ci/Jenkinsfile
//
// Hardened Multi-Branch Declarative CI/CD Pipeline for Atos Graduation Project
// - Enforces SonarQube Quality Gate & Trivy Security Scans
// - Enforces Semantic Versioning via S3 Monotonic Version Gate (dev -> test -> prod)
// - Handles Full Lifecycle: Feature PR -> Dev Merge -> Test Promotion -> Prod Release
// - Deploys via Argo CD Image Updater (Zero Git push in Jenkins, Zero :latest mutable tag)

pipeline {
    agent none

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    stages {

        // ═══════════════════════════════════════════
        // STAGE 1: Single Top-Level Checkout & Setup
        // ═══════════════════════════════════════════
        stage('Checkout & Setup') {
            agent { label 'master' }
            steps {
                checkout scm
                script {
                    readVersion()
                    env.APP_NAME = pipelineConfig?.libraries?.ecr?.ecr_repository ?: 'petclinic'
                    login()
                    echo "════════════════════════════════════════════════════"
                    echo "  Target App:     ${env.APP_NAME}"
                    echo "  App Version:    ${env.APP_VERSION}"
                    echo "  ECR Registry:   ${env.ECR_REGISTRY}"
                    echo "  Branch / Event: ${env.BRANCH_NAME} (PR Target: ${env.CHANGE_TARGET ?: 'N/A'})"
                    echo "════════════════════════════════════════════════════"
                }
            }
        }

        // ═══════════════════════════════════════════
        // STAGE 2: Version Gate (DEV)
        // ═══════════════════════════════════════════
        stage('Version Gate (DEV)') {
            agent { label 'master' }
            when {
                anyOf {
                    branch 'dev'
                    changeRequest(target: 'dev')
                }
            }
            steps {
                script {
                    boolean isPR = env.CHANGE_ID != null
                    versionGate(
                        environment:       'dev',
                        component:         env.APP_NAME,
                        type:              'APPLICATION',
                        skip_active_check: isPR
                    )
                }
            }
        }

        // ═══════════════════════════════════════════
        // STAGES 3-8: Consolidated Build, Test & Validation (PR & Dev)
        // ═══════════════════════════════════════════
        stage('Build, Test & JaCoCo Coverage') {
            agent { label 'master' }
            when {
                anyOf {
                    branch 'dev'
                    changeRequest(target: 'dev')
                }
            }
            steps {
                // Compiles, executes unit & integration tests with JaCoCo coverage, packages JAR
                verify()
            }
        }

        stage('SonarQube Quality Gate') {
            agent { label 'master' }
            when {
                anyOf {
                    branch 'dev'
                    changeRequest(target: 'dev')
                }
            }
            steps {
                scan()
            }
        }

        stage('Trivy Filesystem Scan') {
            agent { label 'master' }
            when {
                anyOf {
                    branch 'dev'
                    changeRequest(target: 'dev')
                }
            }
            steps {
                scanFilesystem()
            }
        }

        stage('Docker Build') {
            agent { label 'master' }
            when {
                anyOf {
                    branch 'dev'
                    changeRequest(target: 'dev')
                }
            }
            steps {
                buildImage(version: env.APP_VERSION)
            }
        }

        stage('Container Smoke Validation') {
            agent { label 'master' }
            when {
                anyOf {
                    branch 'dev'
                    changeRequest(target: 'dev')
                }
            }
            steps {
                containerValidate(image_uri: env.IMAGE_URI)
            }
        }

        stage('Trivy Image Scan') {
            agent { label 'master' }
            when {
                anyOf {
                    branch 'dev'
                    changeRequest(target: 'dev')
                }
            }
            steps {
                scanImage(image_uri: env.IMAGE_URI)
            }
        }

        // ═══════════════════════════════════════════
        // STAGE 9: Publish Dev Golden Image (dev merge only)
        // ═══════════════════════════════════════════
        stage('Publish to ECR (DEV)') {
            agent { label 'master' }
            when {
                branch 'dev'
                not { changeRequest() }
            }
            steps {
                script {
                    pushImage()
                    promoteDockerImage(
                        source_image: env.IMAGE_URI,
                        target_image: "${env.ECR_REGISTRY}/${env.APP_NAME}:dev-${env.APP_VERSION}"
                    )
                    registerVersion(
                        environment: 'dev',
                        version:     env.APP_VERSION,
                        component:   env.APP_NAME,
                        type:        'APPLICATION',
                        status:      'ACTIVE'
                    )
                    echo "app_ci: Published dev-${env.APP_VERSION}. Argo CD Image Updater will auto-deploy to Dev."
                }
            }
        }

        // ═══════════════════════════════════════════
        // STAGE 10: Staging Promotion (test merge only)
        // ═══════════════════════════════════════════
        stage('Version Gate (TEST)') {
            agent { label 'master' }
            when {
                branch 'test'
                not { changeRequest() }
            }
            steps {
                versionGate(environment: 'test', component: env.APP_NAME, type: 'APPLICATION')
            }
        }

        stage('Promote Image to TEST') {
            agent { label 'master' }
            when {
                branch 'test'
                not { changeRequest() }
            }
            steps {
                script {
                    promoteDockerImage(
                        source_image: "${env.ECR_REGISTRY}/${env.APP_NAME}:${env.APP_VERSION}",
                        target_image: "${env.ECR_REGISTRY}/${env.APP_NAME}:test-${env.APP_VERSION}"
                    )
                    registerVersion(
                        environment: 'test',
                        version:     env.APP_VERSION,
                        component:   env.APP_NAME,
                        type:        'APPLICATION',
                        status:      'ACTIVE'
                    )
                    echo "app_ci: Published test-${env.APP_VERSION}. Argo CD Image Updater will auto-deploy to Test."
                }
            }
        }

        // ═══════════════════════════════════════════
        // STAGES 11-14: Production Release (main merge only)
        // ═══════════════════════════════════════════
        stage('Version Gate (PROD)') {
            agent { label 'master' }
            when {
                branch 'main'
                not { changeRequest() }
            }
            steps {
                versionGate(environment: 'prod', component: env.APP_NAME, type: 'APPLICATION')
            }
        }

        stage('Production Approval Guardrail') {
            when {
                branch 'main'
                not { changeRequest() }
            }
            options {
                timeout(time: 24, unit: 'HOURS')
            }
            steps {
                input message: "Approve deployment of ${env.APP_NAME}:${env.APP_VERSION} to PRODUCTION?", ok: "Release to Prod"
            }
        }

        stage('Production Fresh CVE Scan') {
            agent { label 'master' }
            when {
                branch 'main'
                not { changeRequest() }
            }
            steps {
                script {
                    sh "docker pull ${env.ECR_REGISTRY}/${env.APP_NAME}:${env.APP_VERSION}"
                    scanImage(image_uri: "${env.ECR_REGISTRY}/${env.APP_NAME}:${env.APP_VERSION}")
                }
            }
        }

        stage('Promote Image to PROD') {
            agent { label 'master' }
            when {
                branch 'main'
                not { changeRequest() }
            }
            steps {
                script {
                    promoteDockerImage(
                        source_image: "${env.ECR_REGISTRY}/${env.APP_NAME}:${env.APP_VERSION}",
                        target_image: "${env.ECR_REGISTRY}/${env.APP_NAME}:prod-${env.APP_VERSION}"
                    )
                    createTag(version: env.APP_VERSION)
                    registerVersion(
                        environment: 'prod',
                        version:     env.APP_VERSION,
                        component:   env.APP_NAME,
                        type:        'APPLICATION',
                        status:      'ACTIVE'
                    )
                    echo "app_ci: Published prod-${env.APP_VERSION}. Argo CD Image Updater will auto-deploy to Production."
                }
            }
        }
    }

    post {
        always {
            node('master') {
                cleanWs()
            }
        }
        success {
            echo "app_ci: Pipeline SUCCEEDED for branch '${env.BRANCH_NAME}' (Version: ${env.APP_VERSION ?: 'N/A'})."
        }
        failure {
            echo "app_ci: Pipeline FAILED on branch '${env.BRANCH_NAME}' (Version: ${env.APP_VERSION ?: 'N/A'})."
        }
    }
}