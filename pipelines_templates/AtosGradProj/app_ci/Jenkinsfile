// pipelines_templates/AtosGradProj/app_ci/Jenkinsfile
//
// Declarative CI/CD Pipeline — Atos Graduation Project
// Flow: Feature PR -> Dev Merge -> Test Promotion -> Prod Release
// Deploys via Argo CD Image Updater (immutable tags: dev-*, test-*, prod-*)

pipeline {
    agent none

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    stages {

        // ════════════════════════════════════════════════════════════════════
        // 1. CI & DEV: Triggered on Branches (main) and Pull Requests
        // ════════════════════════════════════════════════════════════════════
        stage('CI & Dev') {
            agent { label 'master' }
            when {
                not { buildingTag() }
                beforeAgent true
            }
            stages {
                stage('Version Check') {
                    steps {
                        getGitVersion()
                        assumeRole {
                            login ()
                            imageExists(tag: "dev-${env.GIT_TAG}")
                        }
                    }
                }

                stage('Compile') {
                    steps { compileApp() }
                }

                // stage('Trivy FS Scan') {
                //     steps { scanFilesystem() }
                // }

                stage('Unit Test') {
                    steps { test() }
                }

                stage('SonarQube Analysis') {
                    steps { scan() }
                }

                stage('Maven Package') {
                    steps { packageApp() }
                }

                stage('Docker Build') {
                    steps {
                        buildImage(tag:"dev-${env.SHORT_SHA}")
                    }
                }

                stage('Deploy to DEV') {
                    when {
                        allOf {
                            branch 'main'
                            not { changeRequest() }
                        }
                    }
                    steps {
                        push("dev-${env.GIT_SHORT_SHA}")
                        sh "echo 'Deployed dev-${env.GIT_SHORT_SHA} to DEV environment via Argo CD.'"
                    }
                }
            }
        }

        // ════════════════════════════════════════════════════════════════════
        // 2. PROMOTION TO TEST: Triggered by Release Candidate Tag (v*-rc*)
        // ════════════════════════════════════════════════════════════════════
        stage('Promote to TEST') {
            agent { label 'master' }
            when {
                tag pattern: "v*-rc", comparator: "GLOB"
                beforeAgent true
            }
            steps {
                getGitVersion()
                echo "Promoting Release Candidate '${env.GIT_TAG}' to TEST environment..."
                assumeRole {
                    login()
                    retagImage(
                        source_tag: "dev-${env.GIT_SHORT_SHA}",
                        target_tag: "test-${env.GIT_TAG}"
                    )
                }
                sh "echo 'Automated verification completed on TEST environment for test-${env.GIT_TAG}.'"
            }
        }

        // ════════════════════════════════════════════════════════════════════
        // 3. PROMOTION TO PRODUCTION: Triggered by Official Release Tag (v*)
        //    Strict Promotion: Retags directly from the verified TEST candidate
        // ════════════════════════════════════════════════════════════════════
        stage('Release to PROD') {
            agent { label 'master' }
            when {
                allOf {
                    tag pattern: "v*", comparator: "GLOB"
                    not { tag pattern: "v*-rc*", comparator: "GLOB" }
                }
                beforeAgent true
            }
            steps {
                getGitVersion()
                echo "Promoting Official Release '${env.GIT_TAG}' to PRODUCTION..."
                // Strict chain: Retags directly from the tested RC image (fails if RC was never pushed)
                assumeRole {
                    login()
                    retagImage(
                        source_tag: "test-${env.GIT_TAG}-rc",
                        target_tag: "prod-${env.GIT_TAG}"
                    )
                }
                sh "echo 'Production release prod-${env.GIT_TAG} deployed successfully via Argo CD.'"
            }
        }
    }

    post {
        success { echo "app_ci: SUCCEEDED — ${env.TAG_NAME ? 'Tag: ' + env.TAG_NAME : 'Branch: ' + env.BRANCH_NAME} (GIT_TAG: ${env.GIT_TAG ?: 'N/A'})" }
        failure { echo "app_ci: FAILED    — ${env.TAG_NAME ? 'Tag: ' + env.TAG_NAME : 'Branch: ' + env.BRANCH_NAME} (GIT_TAG: ${env.GIT_TAG ?: 'N/A'})" }
    }
}