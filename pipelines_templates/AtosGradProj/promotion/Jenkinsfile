// pipelines_templates/AtosGradProj/promotion/Jenkinsfile
//
// Promotion Pipeline (Declarative Syntax)
// Flow:
//   Checkout -> Determine Source/Target & Version -> Validate Version
//   -> Version Gate -> Verify Image Exists in ECR -> Update GitOps & Open PR
//   -> Human Review & Merge Approval -> Register Promotion in Registry

pipeline {
    agent {
        label 'master'
    }

    parameters {
        choice(
            name: 'TARGET_ENVIRONMENT',
            choices: ['test', 'prod'],
            description: 'Target environment for promotion (dev -> test, test -> prod)'
        )
        string(
            name: 'VERSION_OVERRIDE',
            defaultValue: '',
            description: 'Optional: Version tag to promote (leave empty to use VERSION file)'
        )
    }

    stages {

        // ───────────────────────────────────────────
        // STAGE 1: Checkout Source Code
        // ───────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ───────────────────────────────────────────
        // STAGE 2: Determine Source/Target & Version
        // ───────────────────────────────────────────
        stage('Determine Environments & Version') {
            steps {
                script {
                    Map allowedTransitions = ['test': 'dev', 'prod': 'test']
                    String targetEnv = params.TARGET_ENVIRONMENT

                    if (!targetEnv || !allowedTransitions.containsKey(targetEnv)) {
                        error "promotion: TARGET_ENVIRONMENT must be one of ${allowedTransitions.keySet()}."
                    }

                    env.TARGET_ENVIRONMENT = targetEnv
                    env.SOURCE_ENVIRONMENT = allowedTransitions[targetEnv]
                    echo "promotion: ${env.SOURCE_ENVIRONMENT} -> ${env.TARGET_ENVIRONMENT}"

                    if (params.VERSION_OVERRIDE?.trim()) {
                        env.APP_VERSION = params.VERSION_OVERRIDE.trim()
                    } else {
                        readVersion()
                    }

                    validateVersion()
                }
            }
        }

        // ───────────────────────────────────────────
        // STAGE 3: Version Gate
        // ───────────────────────────────────────────
        stage('Version Gate') {
            steps {
                versionGate(environment: env.TARGET_ENVIRONMENT)
            }
        }

        // ───────────────────────────────────────────
        // STAGE 4: Verify Image Exists in ECR
        // ───────────────────────────────────────────
        stage('Verify Image in ECR') {
            steps {
                script {
                    String repo = pipelineConfig.libraries?.ecr?.ecr_repository ?: 'petclinic'
                    echo "promotion: verifying image '${env.APP_VERSION}' exists in repository '${repo}'..."

                    int found = sh(
                        script: "aws ecr describe-images --repository-name ${repo} --image-ids imageTag=${env.APP_VERSION}",
                        returnStatus: true
                    )
                    if (found != 0) {
                        error "promotion: image tag '${env.APP_VERSION}' was not found in ECR repository '${repo}'. Promotion requires an already-published image."
                    }
                    echo "promotion: confirmed '${env.APP_VERSION}' exists in ECR."
                }
            }
        }

        // ───────────────────────────────────────────
        // STAGE 5: GitOps Update & Create Promotion PR
        // ───────────────────────────────────────────
        stage('GitOps: Update Target & Open PR') {
            steps {
                script {
                    updateValues(environment: env.TARGET_ENVIRONMENT, version: env.APP_VERSION)
                    createPromotionPR(
                        version: env.APP_VERSION,
                        source_environment: env.SOURCE_ENVIRONMENT,
                        target_environment: env.TARGET_ENVIRONMENT
                    )
                }
            }
        }

        // ───────────────────────────────────────────
        // STAGE 6: Await Human PR Review & Merge
        // ───────────────────────────────────────────
        stage('Await PR Review & Merge') {
            input {
                message "Promotion PR for ${env.APP_VERSION} (${env.SOURCE_ENVIRONMENT} -> ${env.TARGET_ENVIRONMENT}) opened. Confirm it has been reviewed and merged."
                ok "Confirm Merged"
            }
            steps {
                echo "promotion: PR merge confirmed by human reviewer."
            }
        }

        // ───────────────────────────────────────────
        // STAGE 7: Register Promotion
        // ───────────────────────────────────────────
        stage('Register Promotion') {
            steps {
                registerVersion(environment: env.TARGET_ENVIRONMENT, version: env.APP_VERSION)
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "promotion: SUCCEEDED. '${env.APP_VERSION}' registered for '${env.TARGET_ENVIRONMENT}'."
        }
        failure {
            echo "promotion: FAILED for version '${env.APP_VERSION ?: 'N/A'}' -> '${env.TARGET_ENVIRONMENT ?: 'N/A'}'."
        }
    }
}