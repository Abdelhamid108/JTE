// pipelines_templates/AtosGradProj/terraform_ci/Jenkinsfile
//
// Infrastructure CI Pipeline (Declarative Syntax)
// Flow:
//   Checkout -> Change Detection -> Install Tools -> Init -> Validate
//   -> Security Scan (Checkov) -> Plan -> Manual Approval -> Deploy / Destroy

pipeline {
    agent {
        label 'master'
    }

    parameters {
        choice(
            name: 'ACTION',
            choices: ['apply', 'destroy'],
            description: 'Action to perform on infrastructure'
        )
    }

    stages {

        // ───────────────────────────────────────────
        // STAGE 1: Checkout Infrastructure Code
        // ───────────────────────────────────────────
        stage('Checkout Code') {
            steps {
                checkoutCode()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 2: Change Detection (Apply runs only)
        // ───────────────────────────────────────────
        stage('Change Detection') {
            when {
                expression { return params.ACTION != 'destroy' }
            }
            steps {
                script {
                    if (!terraformChanged()) {
                        echo "terraform_ci: no changes under terraform/** or JTE/** — skipping the rest of the infrastructure pipeline."
                        currentBuild.result = 'SUCCESS'
                    }
                }
            }
        }

        // ───────────────────────────────────────────
        // STAGE 3: Install Agent Tools
        // ───────────────────────────────────────────
        stage('Install Tools') {
            when {
                allOf {
                    expression { return currentBuild.result != 'SUCCESS' }
                    expression { return pipelineConfig.libraries?.terraform?.install_tools == true }
                }
            }
            steps {
                installTools()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 4: Terraform Init
        // ───────────────────────────────────────────
        stage('Terraform Init') {
            when {
                expression { return currentBuild.result != 'SUCCESS' }
            }
            steps {
                init()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 5: Terraform Validate & Syntax Check
        // ───────────────────────────────────────────
        stage('Terraform Validate') {
            when {
                expression { return currentBuild.result != 'SUCCESS' }
            }
            steps {
                validate()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 6: Security Scan (Checkov)
        // ───────────────────────────────────────────
        stage('Security Scan (Checkov)') {
            when {
                expression { return currentBuild.result != 'SUCCESS' }
            }
            steps {
                checkov()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 7: Terraform Plan
        // ───────────────────────────────────────────
        stage('Terraform Plan') {
            when {
                expression { return currentBuild.result != 'SUCCESS' }
            }
            steps {
                plan()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 8: Approval Guardrail
        // ───────────────────────────────────────────
        stage('Approval Guardrail') {
            when {
                expression { return currentBuild.result != 'SUCCESS' }
            }
            steps {
                approval(is_destroy: params.ACTION == 'destroy')
            }
        }

        // ───────────────────────────────────────────
        // STAGE 9: Execute Deploy / Destroy
        // ───────────────────────────────────────────
        stage('Execute Deploy / Destroy') {
            when {
                expression { return currentBuild.result != 'SUCCESS' }
            }
            steps {
                script {
                    if (params.ACTION == 'destroy') {
                        destroy()
                    } else {
                        deploy()
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "terraform_ci: Action '${params.ACTION}' completed successfully."
        }
        failure {
            echo "terraform_ci: Action '${params.ACTION}' FAILED."
        }
    }
}