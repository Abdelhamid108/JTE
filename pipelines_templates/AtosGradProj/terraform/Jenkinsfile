// pipelines_templates/AtosGradProj/terraform/Jenkinsfile
//
// Hardened Declarative Infrastructure CI/CD Pipeline
// Supports: PR Speculative Plan, Main Deployment, S3 Lineage Tracking, and Safe Destroy

pipeline {
    agent none

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    parameters {
        choice(
            name: 'ACTION',
            choices: ['apply', 'destroy'],
            description: 'Infrastructure lifecycle action to perform'
        )
    }

    stages {

        // ───────────────────────────────────────────
        // STAGE 1: Checkout Infrastructure Code
        // ───────────────────────────────────────────
        stage('Checkout Code') {
            agent { label 'master' }
            steps {
                checkoutCode()
                script {
                    readVersion()
                    echo "════════════════════════════════════════════════════"
                    echo "  Infrastructure Version: ${env.APP_VERSION}"
                    echo "  Action:                 ${params.ACTION}"
                    echo "  Branch / Event:         ${env.BRANCH_NAME}"
                    echo "════════════════════════════════════════════════════"
                }
            }
        }

        // ───────────────────────────────────────────
        // STAGE 2: Install Agent Tools
        // ───────────────────────────────────────────
        stage('Install Tools') {
            agent { label 'master' }
            when {
                expression { return pipelineConfig.libraries?.terraform?.install_tools == true }
            }
            steps {
                installTools()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 3: Terraform Init
        // ───────────────────────────────────────────
        stage('Terraform Init') {
            agent { label 'master' }
            steps {
                init()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 4: Terraform Validate & Syntax Check
        // ───────────────────────────────────────────
        stage('Terraform Validate') {
            agent { label 'master' }
            steps {
                validate()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 5: Security Scan (Checkov)
        // ───────────────────────────────────────────
        stage('Security Scan (Checkov)') {
            agent { label 'master' }
            steps {
                checkov()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 6: Terraform Plan
        // ───────────────────────────────────────────
        stage('Terraform Plan') {
            agent { label 'master' }
            steps {
                plan()
            }
        }

        // ───────────────────────────────────────────
        // STAGE 7: Approval Guardrail (Releases executor)
        // ───────────────────────────────────────────
        stage('Approval Guardrail') {
            when {
                branch 'main'
                not { changeRequest() }
            }
            options {
                timeout(time: 24, unit: 'HOURS')
            }
            steps {
                approval(is_destroy: params.ACTION == 'destroy')
            }
        }

        // ───────────────────────────────────────────
        // STAGE 8: Execute Deploy / Destroy
        // ───────────────────────────────────────────
        stage('Execute Deploy / Destroy') {
            agent { label 'master' }
            when {
                branch 'main'
                not { changeRequest() }
            }
            steps {
                script {
                    if (params.ACTION == 'destroy') {
                        destroy()
                    } else {
                        deploy()
                    }
                }
            }
        }

        // ───────────────────────────────────────────
        // STAGE 9: Register Infrastructure Lineage in S3
        // ───────────────────────────────────────────
        stage('Register Infrastructure Lineage') {
            agent { label 'master' }
            when {
                allOf {
                    branch 'main'
                    expression { return params.ACTION == 'apply' }
                    not { changeRequest() }
                }
            }
            steps {
                script {
                    registerVersion(
                        type: 'INFRASTRUCTURE',
                        component: 'eks-cluster',
                        version: env.APP_VERSION,
                        environment: 'prod'
                    )
                }
            }
        }
    }

    post {
        always {
            node('master') {
                cleanWs()
            }
        }
        success {
            echo "terraform_ci: Action '${params.ACTION}' completed successfully for Infra '${env.APP_VERSION ?: 'N/A'}' on branch '${env.BRANCH_NAME}'."
        }
        failure {
            echo "terraform_ci: Action '${params.ACTION}' FAILED."
        }
    }
}